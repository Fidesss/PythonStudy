   "source": [
    "* 숫자를 입력받아서 아래 조건에 맞게 출력하세요\n",
    "* 짝수이면서 10보다 크면 -> \"큰 짝수입니다\"\n",
    "* 짝수지만 10이하이면 -> \"작은 짝수입니다\"\n",
    "* 홀수이면 -> \"홀수 입니다.\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "a062de4b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "홀수 입니다.\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"정수 입력> \"))\n",
    "\n",
    "if num % 2 == 0 and num > 10:\n",
    "    print(\"큰 짝수입니다.\")\n",
    "\n",
    "if num % 2 == 0 and num <= 10:\n",
    "    print(\"작은 짝수입니다.\")\n",
    "\n",
    "if num % 2 == 1:\n",
    "    print(\"홀수 입니다.\")"
   ]
  }
 ],
